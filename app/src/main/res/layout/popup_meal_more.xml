<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_meal_overflow_menu"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/actionEditTime"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/diet_meal_edit_time"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/actionEditMemo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/diet_meal_edit_memo"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="12dp"
        android:background="@color/divider_subtle" />

    <TextView
        android:id="@+id/actionDeleteMeal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/diet_meal_delete"
        android:textColor="@color/accent"
        android:textSize="14sp" />
</LinearLayout>
