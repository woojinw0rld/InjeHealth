<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_border"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <EditText
        android:id="@+id/etFoodName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/diet_add_food_name_hint"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_disabled"
        android:textSize="14sp"
        android:background="@null"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etKcal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/diet_add_kcal_hint"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="12sp"
            android:background="@null"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/etCarbs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/diet_add_carbs_hint"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="12sp"
            android:background="@null"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/etProtein"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/diet_add_protein_hint"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="12sp"
            android:background="@null"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/etFat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/diet_add_fat_hint"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="12sp"
            android:background="@null" />
    </LinearLayout>
</LinearLayout>
