<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/surface">

    <!-- 타이틀 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diet_add_meal_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- 시간 행 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diet_add_meal_time_label"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvSelectedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diet_meal_time_placeholder"
            android:textColor="@color/primary" />

        <TextView
            android:id="@+id/btnChangeTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/diet_add_meal_time_change"
            android:textColor="@color/primary"
            android:padding="4dp" />
    </LinearLayout>

    <!-- 메모 입력 -->
    <EditText
        android:id="@+id/etMemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/diet_add_meal_memo_hint"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_input_field"
        android:padding="10dp"
        android:layout_marginBottom="12dp" />

    <!-- 사진 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <!-- 사진 썸네일 (선택 후 표시) -->
        <ImageView
            android:id="@+id/ivPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_photo_thumb"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- 사진 버튼 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btnPhotoCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/diet_add_meal_photo_camera"
                android:textColor="@color/primary"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/btnPhotoGallery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/diet_add_meal_photo_gallery"
                android:textColor="@color/primary"
                android:gravity="center"
                android:padding="8dp" />

            <TextView
                android:id="@+id/btnPhotoRemove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/diet_add_meal_photo_remove"
                android:textColor="@color/accent"
                android:gravity="center"
                android:padding="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 음식 섹션 타이틀 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diet_add_meal_food_section_title"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- 음식 목록 컨테이너 (동적으로 추가) -->
    <LinearLayout
        android:id="@+id/containerFoodItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 음식 추가 버튼 -->
    <TextView
        android:id="@+id/btnAddFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diet_add_meal_food_add"
        android:textColor="@color/primary"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginTop="4dp" />

    <!-- 저장/취소 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diet_add_cancel"
            android:layout_marginEnd="8dp"
            style="@style/Widget.AppCompat.Button.Borderless" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diet_add_save" />
    </LinearLayout>

</LinearLayout>
